# TazaaConnect Environment Configuration Template
VITE_APP_NAME=TazaaConnect
VITE_ENVIRONMENT=development

# Local Ollama Gemma 4 Configuration
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_GEMMA_MODEL=gemma4:latest

# Google Gemini Cloud AI Integration
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-3.5-flash

# Snowflake CoCo Demand Intelligence Configuration
VITE_SNOWFLAKE_ACCOUNT=your_snowflake_account_placeholder
VITE_SNOWFLAKE_WAREHOUSE=COMPUTE_WH
VITE_SNOWFLAKE_DATABASE=TAZAACONNECT_ANALYTICS
VITE_SNOWFLAKE_SERVICE_MODE=coco_mock

# Solana Trust Protocol Configuration
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
